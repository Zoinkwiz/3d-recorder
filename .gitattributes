# Markdown uses two trailing spaces as a hard line break; .editorconfig
# already exempts *.md from trailing-whitespace trimming, so keep
# `git diff --check` consistent with that policy.
*.md whitespace=-blank-at-eol

# Office documents are zipped XML: keep Git from normalising line endings inside them.
*.pptx binary
*.docx binary
*.xlsx binary
