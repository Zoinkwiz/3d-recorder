# Line endings: LF everywhere, CRLF only for Windows command scripts.
* text=auto eol=lf

# Windows command scripts are the only text files kept as CRLF by default.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep common binary formats out of Git's text and diff heuristics.
